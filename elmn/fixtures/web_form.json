  "client_script": "\nfrappe.web_form.events.on(\"after_load\", () => {\n    const token = frappe.utils.get_url_arg(\"token\");\n    if (!token) return;\n\n    frappe.call({\n        method: \"elmn.api.invitation.validate_and_start_invitation\",\n        args: { token },\n        callback(r) {\n            const result = r.message || {};\n            if (!result.valid) {\n                $(\".web-form-wrapper\").html(\n                    '<div class=\"text-center\" style=\"padding: 60px 20px;\">' +\n                    '<h4>' + __(\"This invitation link is no longer valid\") + '</h4>' +\n                    '<p>' + frappe.utils.escape_html(result.message || \"\") + '</p>' +\n                    '<p>' + __(\"Please contact MLN for a new invitation link.\") + '</p>' +\n                    '</div>'\n                );\n                return;\n            }\n            frappe.web_form.set_values(Object.assign({ invitation_token: token }, result.prefill || {}));\n        },\n    });\n});\n\nfrappe.web_form.events.on(\"after_load\", () => {\n    const geocode_field = frappe.web_form.fields_dict.geocode;\n    if (!geocode_field || !geocode_field.$wrapper || !navigator.geolocation) return;\n\n    const btn = $(\n        '<button type=\"button\" class=\"btn btn-xs btn-default\" style=\"margin-top: 6px;\">' +\n        __(\"Use my current location\") + '</button>'\n    );\n    geocode_field.$wrapper.append(btn);\n    btn.on(\"click\", () => {\n        navigator.geolocation.getCurrentPosition((pos) => {\n            frappe.web_form.set_value(\"geocode\", pos.coords.latitude + \",\" + pos.coords.longitude);\n        });\n    });\n});\n",
