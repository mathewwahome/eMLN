  "client_script": "\nfrappe.web_form.events.on(\"after_load\", () => {\n    const field = frappe.web_form.fields_dict.commodities;\n    if (!field || !field.grid) return;\n\n    field.grid.get_field(\"commodity\").get_query = (doc, cdt, cdn) => {\n        const row = locals[cdt][cdn];\n        return { filters: row.commodity_category ? { item_group: row.commodity_category } : {} };\n    };\n});\n\nfrappe.web_form.events.on(\"after_load\", () => {\n    frappe.call({\n        method: \"elmn.api.vendor.get_vendor_registration_info\",\n        callback(r) {\n            frappe.web_form._registration_info = r.message || {};\n        },\n    });\n\n    const original_render_success_page = frappe.web_form.render_success_page.bind(frappe.web_form);\n    frappe.web_form.render_success_page = function (data) {\n        original_render_success_page(data);\n\n        if (data.status === \"Draft\") {\n            $(\".success-title\").text(__(\"Draft saved\"));\n            $(\".success-message\").text(\n                __(\"We've emailed you a link to continue this application later. It stays available for {0} day(s).\", [\n                    data._draft_expiry_days || \"\",\n                ])\n            );\n            return;\n        }\n\n        const info = frappe.web_form._registration_info || {};\n        const categories = Array.from(\n            new Set((data.commodities || []).map((row) => row.commodity_category).filter(Boolean))\n        );\n        const document_names = (data.documents || [])\n            .filter((row) => row.attachment)\n            .map((row) => row.document_type);\n\n        const summary_rows = [\n            [__(\"Reference Number\"), frappe.utils.escape_html(data.name || \"\")],\n            [__(\"Company\"), frappe.utils.escape_html(data.legal_entity_name || \"\")],\n            [__(\"Contact Email\"), frappe.utils.escape_html(data.primary_contact_email || \"\")],\n            [__(\"Categories\"), frappe.utils.escape_html(categories.join(\", \"))],\n            [__(\"Submitted\"), data.creation ? frappe.datetime.str_to_user(data.creation) : \"\"],\n        ];\n        if (document_names.length) {\n            summary_rows.push([__(\"Documents received\"), frappe.utils.escape_html(document_names.join(\", \"))]);\n        }\n\n        const summary_html =\n            '<div class=\"success-summary\" style=\"border:1px solid var(--border-color, #e0e0e0);border-radius:8px;padding:16px 20px;margin-top:24px;\">' +\n            summary_rows\n                .filter((row) => row[1])\n                .map(\n                    (row) =>\n                        '<div style=\"display:flex;justify-content:space-between;gap:16px;padding:6px 0;\">' +\n                        '<span style=\"color:var(--text-muted, #8d99a6);\">' + row[0] + '</span>' +\n                        '<span style=\"font-weight:600;text-align:right;\">' + row[1] + '</span>' +\n                        '</div>'\n                )\n                .join(\"\") +\n            '</div>';\n\n        const next_steps_text = info.expected_processing_days\n            ? __(\n                \"MediLink's procurement and clinical teams will review your application (commercial vetting and product quality assessment run in parallel), typically within about {0} day(s). You will be notified by email at each stage. If approved, you will receive an account activation link.\",\n                [info.expected_processing_days]\n            )\n            : __(\n                \"MediLink's procurement and clinical teams will review your application (commercial vetting and product quality assessment run in parallel). You will be notified by email at each stage. If approved, you will receive an account activation link.\"\n            );\n\n        const contact = [info.support_email, info.support_phone].filter(Boolean).join(\" / \");\n        const contact_html = contact\n            ? \" \" + __(\"Questions? Contact MediLink at {0}.\", [frappe.utils.escape_html(contact)])\n            : \"\";\n\n        const next_steps_html =\n            '<div class=\"success-next-steps\" style=\"background:var(--bg-blue, #eaf2ff);border-radius:8px;padding:16px 20px;margin-top:20px;\">' +\n            '<b>' + __(\"What happens next?\") + '</b> ' + next_steps_text + contact_html +\n            '</div>';\n\n        $(\".success-message\").after(summary_html + next_steps_html);\n\n        $(\".success-footer\")\n            .empty()\n            .append(\n                '<a href=\"/\" class=\"btn btn-link\">&larr; ' + __(\"Return to MediLink homepage\") + '</a>'\n            );\n    };\n});\n\nfrappe.web_form.events.on(\"after_load\", () => {\n    const params = new URLSearchParams(window.location.search);\n    const token = params.get(\"draft_token\");\n    if (!token) return;\n\n    frappe.call({\n        method: \"elmn.api.vendor.resume_vendor_draft\",\n        args: { token },\n        callback(r) {\n            const result = r.message || {};\n            if (!result.valid) {\n                $(\".web-form-wrapper\").html(\n                    '<div class=\"text-center\" style=\"padding: 60px 20px;\">' +\n                    '<h4>' + __(\"This draft link is no longer valid\") + '</h4>' +\n                    '<p>' + frappe.utils.escape_html(result.message || \"\") + '</p>' +\n                    '</div>'\n                );\n                return;\n            }\n            frappe.web_form._resuming_token = token;\n            frappe.web_form.set_values(result.prefill || {});\n        },\n    });\n});\n\nfrappe.web_form.events.on(\"after_load\", () => {\n    frappe.web_form._custom_save = function (is_draft) {\n        const doc_values = this.get_values(true);\n        if (!doc_values) return false;\n        if (window.saving) return false;\n\n        Object.assign(this.doc, doc_values);\n        this.doc.doctype = this.doc_type;\n\n        window.saving = true;\n        frappe.form_dirty = false;\n\n        frappe.call({\n            type: \"POST\",\n            method: \"elmn.api.vendor.save_vendor_application\",\n            args: {\n                data: this.doc,\n                draft: is_draft ? 1 : 0,\n                resuming_token: this._resuming_token || null,\n            },\n            freeze: true,\n            callback: (response) => {\n                if (!response.exc) {\n                    this.handle_success(response.message);\n                    frappe.web_form.events.trigger(\"after_save\");\n                }\n            },\n            always: () => {\n                window.saving = false;\n            },\n        });\n        return false;\n    };\n\n    frappe.web_form.save = function () {\n        const is_last_page =\n            !this.is_multi_step_form || this.current_section === this.page_breaks.length;\n        return this._custom_save(!is_last_page);\n    };\n\n    const update_submit_label = () => {\n        const is_last_page =\n            !frappe.web_form.is_multi_step_form ||\n            frappe.web_form.current_section === frappe.web_form.page_breaks.length;\n        $(\".submit-btn\").text(is_last_page ? __(\"Submit Application\") : __(\"Save as Draft\"));\n    };\n\n    const original_toggle_buttons = frappe.web_form.toggle_buttons.bind(frappe.web_form);\n    frappe.web_form.toggle_buttons = function () {\n        original_toggle_buttons();\n        update_submit_label();\n    };\n\n    update_submit_label();\n});\n",
