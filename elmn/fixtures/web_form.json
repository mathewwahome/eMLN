  "client_script": "\nfrappe.web_form.events.on(\"after_load\", () => {\n    const params = new URLSearchParams(window.location.search);\n    const token = params.get(\"token\");\n    if (!token) {\n        $(\".web-form-wrapper\").html(\n            '<div class=\"text-center\" style=\"padding: 60px 20px;\">' +\n            '<h4>' + __(\"Missing link\") + '</h4>' +\n            '<p>' + __(\"Please use the link from the email you received.\") + '</p>' +\n            '</div>'\n        );\n        return;\n    }\n\n    frappe.call({\n        method: \"elmn.api.vendor.resume_rfi_response\",\n        args: { token },\n        callback(r) {\n            const result = r.message || {};\n            if (!result.valid) {\n                $(\".web-form-wrapper\").html(\n                    '<div class=\"text-center\" style=\"padding: 60px 20px;\">' +\n                    '<h4>' + __(\"This link is no longer valid\") + '</h4>' +\n                    '<p>' + frappe.utils.escape_html(result.message || \"\") + '</p>' +\n                    '</div>'\n                );\n                return;\n            }\n            frappe.web_form._response_token = token;\n            frappe.web_form.set_values(result.prefill || {});\n        },\n    });\n});\n\nfrappe.web_form.events.on(\"after_load\", () => {\n    frappe.web_form.save = function () {\n        const doc_values = this.get_values(true);\n        if (!doc_values) return false;\n        if (window.saving) return false;\n        if (!this._response_token) {\n            frappe.msgprint(__(\"This link is invalid. Please use the link from the email you received.\"));\n            return false;\n        }\n\n        window.saving = true;\n        frappe.form_dirty = false;\n\n        frappe.call({\n            type: \"POST\",\n            method: \"elmn.api.vendor.submit_rfi_response\",\n            args: {\n                token: this._response_token,\n                items: doc_values.items || [],\n            },\n            freeze: true,\n            callback: (response) => {\n                if (!response.exc) {\n                    this.handle_success(response.message);\n                    frappe.web_form.events.trigger(\"after_save\");\n                }\n            },\n            always: () => {\n                window.saving = false;\n            },\n        });\n        return false;\n    };\n});\n",
